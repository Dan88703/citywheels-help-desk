# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible chat endpoint works.

# Groq (free tier, key from https://console.groq.com/keys)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini instead (key from https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# Local Ollama instead (no key needed, any non-empty value works):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
